{
  "name": "minimax-h3-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.js --dev",
    "build": "node scripts/build.mjs",
    "build:default": "npm run build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit && npm --workspace web run check",
    "test": "node --test tests/*.test.cjs",
    "test:pipeline": "npm --prefix worker test",
    "typecheck:pipeline": "npm --prefix worker run typecheck",
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "test:ui": "playwright test",
    "test:gpu": "npm --workspace gpu test",
    "typecheck:gpu": "npm --workspace gpu run typecheck",
    "test:backend": "npm --prefix worker run test:runtime",
    "dev:pipeline": "npm --prefix worker run dev -- --port 8790",
    "test:assembly": "npm --workspace gpu run test:assembly"
  },
  "dependencies": {
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "ws": "^8.21.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5"
  },
  "workspaces": [
    "web",
    "gpu"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
