{
  "name": "drama-pipeline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fix": "node --import tsx scripts/fix.ts",
    "compare": "node --import tsx scripts/bakeoff.ts",
    "dev": "wrangler dev --var AUTH_MODE:local",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test:build": "wrangler deploy --dry-run --outdir .test-build",
    "test:runtime": "npm run test:build && vitest run --config vitest.runtime.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.5",
    "miniflare": "^5.20261019.2-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "jose": "^6.2.13"
  }
}
