{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drama-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drama-pipeline",
      "database_id": "7e2f1ffb-d9bb-4c5e-8fe6-d355697076ae",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "drama-pipeline-media",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGHUB",
        "class_name": "LogHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LogHub"],
    },
  ],
  "vars": {
    "AUTH_MODE": "access",
  },
  "secrets": {
    "required": ["GPU_KEY", "ACCESS_TEAM", "ACCESS_AUD", "OWNER_EMAIL"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "keep_vars": true,
}
